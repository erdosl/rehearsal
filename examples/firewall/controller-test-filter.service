[Unit]
Description=Rehearsal controller test interface filter
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/rehearsal-firewall/test-filter.nft
ExecReload=/usr/sbin/nft -f /etc/rehearsal-firewall/test-filter.nft
ExecStop=/usr/sbin/nft delete table inet rehearsal_test

[Install]
WantedBy=multi-user.target
